{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'none'; connect-src 'self' https:; font-src 'self' https:; frame-src 'self' https:; img-src 'self' * data:; media-src 'self' *; object-src 'self' https:; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; base-uri 'none'; form-action 'self'; frame-ancestors 'self' https:" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "installCommand": "pnpm install --prod",
  "redirects": [
    { "source": "/api/(.*)", "destination": "https://api.yumeharu.top/api/$1" },
    { "source": "/archives/", "destination": "/archive/" },
    { "source": "/categories/life/", "destination": "/archive/?category=日常" },
    { "source": "/categories/life/daily/", "destination": "/archive/?category=日常" },
    { "source": "/categories/life/funny/", "destination": "/archive/?category=搞笑" },
    { "source": "/categories/knowledge/", "destination": "/archive/?category=知识" },
    { "source": "/categories/knowledge/skill/", "destination": "/archive/?category=知识" },
    { "source": "/friend/", "destination": "/friends/" },
    { "source": "/friendship-link/", "destination": "/friends/" },
    { "source": "/friendship-links/", "destination": "/friends/" },
    { "source": "/images/friendship-links/(.+)", "destination": "/assets/images/friends/$1" },
    { "source": "/images/screenshot.png", "destination": "/assets/images/screenshot-light.webp" },
    { "source": "/images/screenshot_compressed.png", "destination": "/assets/images/screenshot-light.webp" },
    { "source": "/images/screenshot_compressed.webp", "destination": "/assets/images/screenshot-light.webp" },
    { "source": "/images/(.+)\\.(png|jpg|jpeg)_compressed\\.(png|webp)", "destination": "/assets/images/$1.$2" },
    { "source": "/images/(.+)_compressed\\.(png|webp)", "destination": "/assets/images/$1.$2" },
    { "source": "/images/((?!albums).+)", "destination": "/assets/images/$1" },
    { "source": "/link/", "destination": "/friends/" },
    { "source": "/links/", "destination": "/friends/" },
    { "source": "/sitemap.xml", "destination": "/sitemap-index.xml" },
    { "source": "/tags/auto-reply/", "destination": "/archive/?tag=自动回复" },
    { "source": "/tags/blog/", "destination": "/archive/?tag=Blog" },
    { "source": "/tags/comments/", "destination": "/archive/?tag=评论" },
    { "source": "/tags/google/", "destination": "/archive/?tag=谷歌" },
    { "source": "/tags/grass/", "destination": "/archive/?tag=生草" },
    { "source": "/tags/technology/", "destination": "/archive/?tag=技术" },
    { "source": "/tags/translation/", "destination": "/archive/?tag=翻译" },
    { "source": "/tags/users-list/", "destination": "/archive/?tag=用户列表" },
    { "source": "/tags/website/", "destination": "/archive/?tag=网站" },
    { "source": "/tags/wuziqian211/", "destination": "/archive/?tag=wuziqian211" },
    { "source": "/tags/yumeharu/", "destination": "/archive/?tag=梦春酱" },
    { "source": "/wiki/", "destination": "/about-me/" }
  ]
}
