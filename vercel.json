{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'none'; connect-src 'self' https:; font-src 'self' https:; frame-src 'self' https:; img-src 'self' * data:; media-src 'self' *; object-src 'self' https:; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; base-uri 'none'; form-action 'self'; frame-ancestors 'self' https:" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "installCommand": "pnpm install --prod",
  "redirects": [
    { "source": "/api/(.*)", "destination": "https://api.yumeharu.top/api/$1" },
    { "source": "/archives/", "destination": "/archive/" },
    { "source": "/friend/", "destination": "/friends/" },
    { "source": "/friendship-link/", "destination": "/friends/" },
    { "source": "/friendship-links/", "destination": "/friends/" },
    { "source": "/images/face_compressed.png", "destination": "/assets/images/face.png" },
    { "source": "/images/face.png_compressed.webp", "destination": "/assets/images/face.png" },
    { "source": "/images/icon_compressed.png", "destination": "/assets/images/icon.png" },
    { "source": "/images/icon.png_compressed.webp", "destination": "/assets/images/icon.png" },
    { "source": "/images/screenshot.png", "destination": "/assets/images/screenshot.webp" },
    { "source": "/images/screenshot_compressed.png", "destination": "/assets/images/screenshot.webp" },
    { "source": "/images/screenshot_compressed.webp", "destination": "/assets/images/screenshot.webp" },
    { "source": "/images/(.*)", "destination": "/assets/images/$1" },
    { "source": "/link/", "destination": "/friends/" },
    { "source": "/links/", "destination": "/friends/" },
    { "source": "/sitemap.xml", "destination": "/sitemap-index.xml" },
    { "source": "/wiki/", "destination": "/about-me/" }
  ]
}
